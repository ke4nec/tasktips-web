    "eslint-plugin-vue": "^10.10.0",
    "happy-dom": "^20.11.2",
    "openapi-typescript": "^7.4.0",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.67.0",
