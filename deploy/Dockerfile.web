# TaskTips Web 静态镜像：构建产物 + nginx（/app/ 基座）。
FROM node:22-alpine AS build
# 生产镜像连真实后端（同源 /api 反代）；mock 仅供本地 UI 开发与 E2E
# （src/api/index.ts 默认 MockApi，VITE_API_MODE=http 切换 HttpApi）。
ENV VITE_API_MODE=http
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY . ./
RUN npm run build

FROM nginx:alpine
COPY --from=build /build/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/snippets/security-headers.conf /etc/nginx/snippets/security-headers.conf
EXPOSE 8080
