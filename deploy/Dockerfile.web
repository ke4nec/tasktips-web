# TaskTips Web 静态镜像：构建产物 + nginx（/app/ 基座）。
FROM node:22-alpine AS build
WORKDIR /build
COPY package.json package-lock.json ./
RUN npm ci
COPY . ./
RUN npm run build

FROM nginx:alpine
COPY --from=build /build/dist /usr/share/nginx/html
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/snippets/security-headers.conf /etc/nginx/snippets/security-headers.conf
EXPOSE 8080
